# Copy to .env and edit; scripts/common.sh loads it automatically.
# All variables are optional; defaults are relative to the repository root.

# Where gagle.zip and all intermediate data live (~40 GB free recommended).
# FRACTALSIG_WORKSPACE=/absolute/path/to/workspace

# Where regenerated statistics, figures and logs are written.
# FRACTALSIG_OUTPUT_DIR=/absolute/path/to/outputs

# Parquet manifest shards written by step 4 and read by steps 7 and 10+.
# GAGLE_MANIFEST_DIR=/absolute/path/to/gpu_manifest_shards

# Worker processes for parallel experiments (default: all visible CPUs).
# FRACTALSIG_WORKERS=8

# Hugging Face cache (models for the GPU pass).
# HF_HOME=/absolute/path/to/hf_cache
